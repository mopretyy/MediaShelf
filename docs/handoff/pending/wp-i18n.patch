diff --git a/src/i18n/languages.test.ts b/src/i18n/languages.test.ts
new file mode 100644
index 0000000..a079be7
--- /dev/null
+++ b/src/i18n/languages.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from 'vitest'
+import { LOCALES } from '../../shared/types.ts'
+import { foldForSearch, languageOptions, matchLanguages } from './languages.ts'
+
+const codes = (options: { code: string }[]) => options.map((option) => option.code)
+
+describe('foldForSearch', () => {
+  it('ignores case, ё and accents', () => {
+    expect(foldForSearch('Română')).toBe('romana')
+    expect(foldForSearch('Français')).toBe('francais')
+    expect(foldForSearch('Español')).toBe('espanol')
+    expect(foldForSearch('Ёлка')).toBe('елка')
+  })
+})
+
+describe('languageOptions', () => {
+  it('lists every locale under its own name, with a hint in the interface language', () => {
+    const options = languageOptions('ru')
+    expect(codes(options)).toEqual([...LOCALES])
+    expect(options.map((option) => option.name)).toEqual([
+      'Русский',
+      'English',
+      'Українська',
+      'Deutsch',
+      'Español',
+      'Français',
+      'Română',
+    ])
+    expect(options.find((option) => option.code === 'de')?.hint).toBe('немецкий')
+    expect(languageOptions('en').find((option) => option.code === 'de')?.hint).toBe('German')
+  })
+
+  it('leaves out a hint that only repeats the name', () => {
+    expect(languageOptions('ru').find((option) => option.code === 'ru')?.hint).toBe('')
+    expect(languageOptions('uk').find((option) => option.code === 'uk')?.hint).toBe('')
+    expect(languageOptions('en').find((option) => option.code === 'en')?.hint).toBe('')
+  })
+})
+
+describe('matchLanguages', () => {
+  const russian = languageOptions('ru')
+  const german = languageOptions('de')
+
+  it('keeps everything for an empty query', () => {
+    expect(matchLanguages(russian, '  ')).toHaveLength(LOCALES.length)
+  })
+
+  it('finds a language by its own name, without the accents', () => {
+    expect(codes(matchLanguages(german, 'francais'))).toEqual(['fr'])
+    expect(codes(matchLanguages(german, 'УКРАЇН'))).toEqual(['uk'])
+    expect(codes(matchLanguages(german, 'рус'))).toEqual(['ru'])
+  })
+
+  it('finds a language by its name in the interface language or in English', () => {
+    expect(codes(matchLanguages(russian, 'немец'))).toEqual(['de'])
+    expect(codes(matchLanguages(german, 'Rumänisch'))).toEqual(['ro'])
+    expect(codes(matchLanguages(german, 'spanish'))).toEqual(['es'])
+  })
+
+  it('finds nothing for something that is not a language', () => {
+    expect(matchLanguages(russian, 'язык')).toEqual([])
+  })
+})
diff --git a/src/i18n/languages.ts b/src/i18n/languages.ts
new file mode 100644
index 0000000..a663bb4
--- /dev/null
+++ b/src/i18n/languages.ts
@@ -0,0 +1,63 @@
+// Relative import (not @shared): unit tests type-check this file under tsconfig.node.json,
+// which has no path aliases.
+import { LOCALES, type Locale } from '../../shared/types.ts'
+
+/** Every interface language named in itself, so people find their own whatever the UI shows. */
+export const LANGUAGE_NAMES: Record<Locale, string> = {
+  ru: 'Русский',
+  en: 'English',
+  uk: 'Українська',
+  de: 'Deutsch',
+  es: 'Español',
+  fr: 'Français',
+  ro: 'Română',
+}
+
+/**
+ * Fully translated locales: parity.test.ts fails when one of them lacks a key that ru.ts has.
+ * The others are partial and fall back to English. Add a locale once its translation is done.
+ */
+export const COMPLETE_LOCALES: readonly Locale[] = ['ru', 'en']
+
+/** Lower case, ё as е and no accents: «francais» finds Français, «romana» finds Română. */
+export function foldForSearch(value: string) {
+  return value
+    .toLocaleLowerCase()
+    .replaceAll('ё', 'е')
+    .normalize('NFD')
+    .replace(/\p{Diacritic}/gu, '')
+}
+
+export interface LanguageOption {
+  code: Locale
+  /** The language's own name. */
+  name: string
+  /** Its name in the interface language, left out when it only repeats `name`. */
+  hint: string
+  /** Folded names it can be found by: its own, in the interface language and in English. */
+  words: string[]
+}
+
+/** The languages for a picker shown in `locale`, in the order of LOCALES. */
+export function languageOptions(locale: Locale): LanguageOption[] {
+  const local = new Intl.DisplayNames([locale], { type: 'language' })
+  const english = new Intl.DisplayNames(['en'], { type: 'language' })
+  return LOCALES.map((code) => {
+    const name = LANGUAGE_NAMES[code]
+    const localName = local.of(code) ?? ''
+    return {
+      code,
+      name,
+      hint: foldForSearch(localName) === foldForSearch(name) ? '' : localName,
+      words: [name, localName, english.of(code) ?? ''].map(foldForSearch),
+    }
+  })
+}
+
+/** The options whose names contain what was typed; all of them for an empty query. */
+export function matchLanguages(options: LanguageOption[], query: string) {
+  const folded = foldForSearch(query.trim())
+  return folded
+    ? options.filter((option) => option.words.some((word) => word.includes(folded)))
+    : options
+}
diff --git a/src/i18n/parity.test.ts b/src/i18n/parity.test.ts
new file mode 100644
index 0000000..2e28cb0
--- /dev/null
+++ b/src/i18n/parity.test.ts
@@ -0,0 +1,104 @@
+import { describe, expect, it } from 'vitest'
+import { LOCALES, type Locale } from '../../shared/types.ts'
+import { de } from './de.ts'
+import { en } from './en.ts'
+import { es } from './es.ts'
+import { fr } from './fr.ts'
+import { COMPLETE_LOCALES } from './languages.ts'
+import { ro } from './ro.ts'
+import { ru } from './ru.ts'
+import { uk } from './uk.ts'
+
+// ru.ts is the source of truth. Every other dictionary may only hold keys that ru.ts has, with the
+// same {placeholders}, and the complete ones must hold all of them. A plural object is one key.
+
+const DICTIONARIES: Record<Locale, object> = { ru, en, uk, de, es, fr, ro }
+const PLURAL_FORMS = new Set(['zero', 'one', 'two', 'few', 'many', 'other'])
+
+type Leaf = string | Record<string, string>
+
+function isPlural(value: unknown): value is Record<string, string> {
+  if (!value || typeof value !== 'object') return false
+  const forms = Object.keys(value)
+  return forms.length > 0 && forms.every((form) => PLURAL_FORMS.has(form))
+}
+
+/** Dotted key → text or plural object. Anything else ends up as a leaf too, to be reported. */
+function flatten(node: object, prefix = '', out = new Map<string, Leaf>()) {
+  for (const [key, value] of Object.entries(node)) {
+    const path = prefix ? `${prefix}.${key}` : key
+    if (value && typeof value === 'object' && !isPlural(value)) flatten(value, path, out)
+    else out.set(path, value)
+  }
+  return out
+}
+
+/** The {names} that translate() fills in, from every form of a plural. */
+function placeholders(leaf: Leaf) {
+  const texts = typeof leaf === 'string' ? [leaf] : Object.values(leaf)
+  const names = texts.flatMap((text) => [...text.matchAll(/\{(\w+)\}/g)].map((match) => match[1]))
+  return [...new Set(names)].sort().join(', ')
+}
+
+/** The forms a language picks for whole numbers, plus `other`, which translate() falls back to. */
+function pluralForms(locale: Locale) {
+  const rules = new Intl.PluralRules(locale)
+  const forms = new Set(['other'])
+  for (let count = 0; count <= 1000; count++) forms.add(rules.select(count))
+  return [...forms]
+}
+
+const source = flatten(ru)
+
+describe('i18n dictionaries', () => {
+  it('ru and en have the same keys and placeholders', () => {
+    const english = flatten(en)
+    expect([...english.keys()].sort()).toEqual([...source.keys()].sort())
+    const differ = [...source].filter(
+      ([key, leaf]) => placeholders(leaf) !== placeholders(english.get(key) ?? ''),
+    )
+    expect(differ.map(([key]) => key)).toEqual([])
+  })
+
+  it.each(LOCALES.filter((locale) => locale !== 'ru'))(
+    '%s only has keys from ru.ts, with the same shape and placeholders',
+    (locale) => {
+      const problems: string[] = []
+      for (const [key, leaf] of flatten(DICTIONARIES[locale])) {
+        const original = source.get(key)
+        if (original === undefined) problems.push(`${key}: not in ru.ts`)
+        else if (typeof leaf !== typeof original)
+          problems.push(`${key}: ${isPlural(leaf) ? 'plural' : 'text'}, ru.ts has the other kind`)
+        else if (placeholders(leaf) !== placeholders(original))
+          problems.push(`${key}: {${placeholders(leaf)}}, ru.ts has {${placeholders(original)}}`)
+      }
+      expect(problems).toEqual([])
+    },
+  )
+
+  it('lists only real locales as complete, ru and en among them', () => {
+    expect(COMPLETE_LOCALES).toEqual(expect.arrayContaining(['ru', 'en']))
+    for (const locale of COMPLETE_LOCALES) expect(LOCALES).toContain(locale)
+  })
+
+  it.each(COMPLETE_LOCALES)('%s translates every key in ru.ts', (locale) => {
+    const keys = flatten(DICTIONARIES[locale])
+    expect([...source.keys()].filter((key) => !keys.has(key))).toEqual([])
+  })
+
+  it.each(LOCALES)('%s has no empty texts and every plural form it needs', (locale) => {
+    const forms = pluralForms(locale)
+    const problems: string[] = []
+    for (const [key, leaf] of flatten(DICTIONARIES[locale])) {
+      if (typeof leaf === 'string') {
+        if (!leaf.trim()) problems.push(`${key}: empty`)
+      } else if (!isPlural(leaf)) {
+        problems.push(`${key}: neither a text nor a plural`)
+      } else {
+        const missing = forms.filter((form) => !leaf[form]?.trim())
+        if (missing.length) problems.push(`${key}: no ${missing.join(', ')}`)
+      }
+    }
+    expect(problems).toEqual([])
+  })
+})
